{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pml-2-telemetry",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-03",
  "analytics_engine_datasets": [
    {
      "binding": "PML2_TELEMETRY",
      "dataset": "pml2_telemetry"
    }
  ],
  "analytics": {
    "binding": "ANALYTICS_SQL"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}